# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_CHARACTER_FEMALE_VOICE_ID=
ELEVENLABS_CHARACTER_MALE_VOICE_ID=

# Optional server-side story improvisation. Without this, freeform choices use
# the built-in deterministic bridge and still enter a validated story route.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.4-mini

# Private Vercel Blob store used by the native email waitlist.
BLOB_READ_WRITE_TOKEN=
